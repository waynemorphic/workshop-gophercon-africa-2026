package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Home(sightings []sighting.Sighting) {
	@layout.Base(layout.BaseProps{
		Title:       "Wild, Observed",
		Description: "A wall of wildlife sightings from around the world.",
	}) {
		@hero(sightings)
		<section class="wall-section" id="sightings" aria-labelledby="sightings-title">
			<div class="wall-section__head reveal">
				<h2 id="sightings-title">The wall</h2>
				<p>{ summaryLine(sighting.Summarise(sightings)) }</p>
			</div>
			if len(sightings) == 0 {
				<p class="empty">No sightings have been ingested yet.</p>
			} else {
				<ul class="wall">
					for i, s := range sightings {
						<li>
							@components.WallTile(s, i)
						</li>
					}
				</ul>
			}
		</section>
	}
}

templ hero(sightings []sighting.Sighting) {
	<section class="hero" aria-labelledby="hero-title">
		if s, photo, ok := heroPhoto(sightings); ok {
			<img class="hero__photo" src={ photo.URL } alt={ components.PhotoAlt(s, photo) }/>
			<div class="hero__spot" aria-hidden="true"></div>
			<p class="hero__note">
				{ components.DisplayName(s.Species) }, seen in { components.Place(s.Location) }.
			</p>
		}
		<div class="hero__top">
			<span>Field notes</span>
			<a class="hero__button" href="#sightings">See the wall</a>
		</div>
		<h1 class="hero__title" id="hero-title">Wild,<br/>observed.</h1>
	</section>
}
